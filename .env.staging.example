NODE_ENV=staging
PORT=8787
ROUTEIQ_DATABASE_MODE=memory
ROUTEIQ_AUTH_MODE=demo
ROUTEIQ_ROUTING_PROVIDER=mock
ROUTEIQ_GOOGLE_ROUTES_ENABLED=false
ROUTEIQ_ENABLE_LIVE_GOOGLE_ROUTES=false
ROUTEIQ_CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/routeiq_staging
# GOOGLE_MAPS_API_KEY=server_side_key_only

# Vercel frontend variables
VITE_ROUTEIQ_API_MODE=backend
VITE_ROUTEIQ_API_BASE=https://your-render-backend.onrender.com
VITE_ROUTEIQ_API_BASE_URL=https://your-render-backend.onrender.com

# Render backend variables
NODE_ENV=production
ROUTEIQ_DATABASE_MODE=postgres
ROUTEIQ_DATABASE_SSL=require
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
ROUTEIQ_CORS_ORIGIN=https://your-vercel-frontend.vercel.app
ROUTEIQ_AUTH_SECRET=replace-with-long-random-secret
ROUTEIQ_DEMO_ADMIN_TOKEN=replace-with-long-random-token
ROUTEIQ_ENABLE_LIVE_GOOGLE_ROUTES=false
ROUTING_PROVIDER=mock
