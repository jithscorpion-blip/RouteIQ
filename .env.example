# RouteIQ frontend/backend environment template
NODE_ENV=development
ROUTEIQ_SERVER_PORT=8787

# Auth
ROUTEIQ_AUTH_SECRET=replace-with-long-random-secret
ROUTEIQ_DEMO_ADMIN_TOKEN=dev-admin-token

# Database
# Default is memory fallback. Use postgres only when DATABASE_URL is ready.
ROUTEIQ_DATABASE_MODE=memory
DATABASE_URL=
ROUTEIQ_DATABASE_SSL=prefer
ROUTEIQ_DATABASE_POOL_MAX=10
ROUTEIQ_RUN_MIGRATIONS=false

# Routing provider
ROUTING_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# CORS
ROUTEIQ_CORS_ORIGIN=*

# P36 frontend API mode switch
# mock = current frontend-only behavior, backend = call RouteIQ backend endpoints
VITE_ROUTEIQ_API_MODE=mock
VITE_ROUTEIQ_API_BASE_URL=http://localhost:8787
VITE_ROUTEIQ_API_TOKEN=dev-admin-token

# P38 live Google Routes protection
# Keep false until billing, quotas, cache, server-only key restrictions, and monitoring are ready.
ROUTEIQ_ENABLE_LIVE_GOOGLE_ROUTES=false
GOOGLE_ROUTES_ENDPOINT=https://routes.googleapis.com/directions/v2:computeRoutes

# P56-P60 hosted staging
VITE_ROUTEIQ_API_MODE=backend
VITE_ROUTEIQ_API_BASE=http://localhost:8787
VITE_ROUTEIQ_API_BASE_URL=http://localhost:8787
ROUTEIQ_BACKEND_URL=http://localhost:8787
ROUTEIQ_FRONTEND_URL=http://localhost:5173
ROUTEIQ_CORS_ORIGIN=http://localhost:5173
