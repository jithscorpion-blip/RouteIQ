{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --registry=https://registry.npmjs.org/"
  },
  "deploy": {
    "startCommand": "npm run server:start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100
  }
}
